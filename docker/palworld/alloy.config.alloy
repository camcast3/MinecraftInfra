logging {
  level  = "info"
  format = "logfmt"
}

local.file_match "docker_logs" {
  path_targets = [{
    __path__ = "/var/lib/docker/containers/*/*.log",
    instance = "palworld-proxmox",
    game     = "palworld",
    job      = "docker",
  }]
  sync_period = "10s"
}

loki.source.file "docker_logs" {
  targets       = local.file_match.docker_logs.targets
  forward_to    = [loki.process.docker_logs.receiver]
  tail_from_end = true
}

local.file_match "backup_logs" {
  path_targets = [{
    __path__ = "/var/log/game-backup/events.log",
    instance = "palworld-proxmox",
    game     = "palworld",
    job      = "game-backup",
  }]
  sync_period = "10s"
}

loki.source.file "backup_logs" {
  targets       = local.file_match.backup_logs.targets
  forward_to    = [loki.process.backup_logs.receiver]
  tail_from_end = true
}

loki.process "docker_logs" {
  stage.docker { }
  forward_to = [loki.write.central.receiver]
}

loki.process "backup_logs" {
  stage.regex {
    expression = "^(?P<backup_signal>game_backup_(?:result|health)) game=(?P<backup_game>[a-z0-9-]+) destination=(?P<backup_destination>[a-z0-9-]+) status=(?P<backup_status>[a-z]+).*$"
  }
  stage.labels {
    values = {
      backup_signal      = "",
      backup_game        = "",
      backup_destination = "",
      backup_status      = "",
    }
  }
  forward_to = [loki.write.central.receiver]
}

loki.write "central" {
  endpoint {
    url = "http://loki-k8s.tail042ec7.ts.net:3100/loki/api/v1/push"
  }
}
