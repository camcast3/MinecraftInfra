worker_processes 1;
error_log /dev/stderr notice;
pid /tmp/nginx.pid;

events {
    worker_connections 1024;
}

stream {
    log_format palworld '$remote_addr [$time_local] $protocol $status '
                        '$bytes_sent $bytes_received $session_time '
                        '"$upstream_addr" "$upstream_bytes_sent" "$upstream_bytes_received"';
    access_log /dev/stdout palworld;

    server {
        listen 8211 udp reuseport;
        proxy_connect_timeout 5s;
        proxy_timeout 10m;
        proxy_pass ${PALWORLD_TAILSCALE_IP}:8211;
    }

    server {
        listen 27015 udp reuseport;
        proxy_connect_timeout 5s;
        proxy_timeout 10m;
        proxy_pass ${PALWORLD_TAILSCALE_IP}:27015;
    }
}
