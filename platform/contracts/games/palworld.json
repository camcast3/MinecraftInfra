{
  "$schema": "../game-contract.schema.json",
  "contractVersion": 1,
  "gameId": "palworld",
  "instanceId": "primary",
  "displayName": "Palworld",
  "lifecycle": "planned",
  "nodeId": "palworld-proxmox",
  "deploymentPath": "docker/palworld/docker-compose.yml",
  "image": {
    "reference": "ghcr.io/pocketpairjp/palserver:v1.0.3.101283@sha256:ffb778dd63a04cf0d901b95e934e547e1fee67234e33102d5b5bf7da36e2b264",
    "tagRequired": true,
    "digestRequired": true,
    "updates": "renovate"
  },
  "ports": [
    {
      "name": "game",
      "publicPort": null,
      "privatePort": 8211,
      "protocol": "udp",
      "exposure": "tailnet",
      "audience": "players"
    },
    {
      "name": "rest-api",
      "publicPort": null,
      "privatePort": 8212,
      "protocol": "tcp",
      "exposure": "tailnet",
      "audience": "admin"
    },
    {
      "name": "node-exporter",
      "publicPort": null,
      "privatePort": 9100,
      "protocol": "tcp",
      "exposure": "tailnet",
      "audience": "monitoring"
    },
    {
      "name": "cadvisor",
      "publicPort": null,
      "privatePort": 8080,
      "protocol": "tcp",
      "exposure": "tailnet",
      "audience": "monitoring"
    },
    {
      "name": "alloy-http",
      "publicPort": null,
      "privatePort": 12345,
      "protocol": "tcp",
      "exposure": "container-only",
      "audience": "monitoring"
    }
  ],
  "edgeRoutes": [
    {
      "name": "azure-player-ingress",
      "edgeNodeId": "azure-proxy",
      "publicPort": 8211,
      "backendPort": 8211,
      "protocol": "udp",
      "backendKeyVaultSecretName": "palworld-tailscale-ip"
    }
  ],
  "persistentPaths": [
    {
      "hostPath": "/data/palworld/data",
      "containerPath": "/pal/Package/Pal/Saved",
      "purpose": "persistent game configuration, world, and save data"
    },
    {
      "hostPath": "/data/palworld/backups",
      "containerPath": null,
      "purpose": "host-systemd local archives, completion metadata, and health signals"
    },
    {
      "hostPath": "/mnt/nas-backups/palworld",
      "containerPath": null,
      "purpose": "mounted NAS backup tier"
    },
    {
      "hostPath": "/data/palworld/tailscale",
      "containerPath": "/var/lib/tailscale",
      "purpose": "per-stack tailnet node identity"
    },
    {
      "hostPath": "/data/palworld/monitoring/alloy",
      "containerPath": "/var/lib/alloy",
      "purpose": "Alloy positions and component state"
    }
  ],
  "limits": {
    "cpus": 8,
    "memory": "24G"
  },
  "probes": [
    {
      "name": "rest-health",
      "type": "authenticated-http",
      "target": "http://localhost:8212/v1/api/info",
      "requiredBeforeProduction": true
    },
    {
      "name": "save-hook",
      "type": "authenticated-http-post",
      "target": "http://localhost:8212/v1/api/save",
      "requiredBeforeProduction": true
    },
    {
      "name": "offsite-backup-freshness",
      "type": "file-freshness",
      "target": "/data/palworld/backups/health/palworld-azure.success",
      "requiredBeforeProduction": true
    }
  ],
  "backupPolicy": {
    "strategy": "private REST announce/save/graceful shutdown, confirmed stop, archive, and health-verified restart from a host systemd service",
    "targets": [
      "local-14d",
      "nas-7d",
      "azure-blob-cold-90d"
    ],
    "retention": "14 days local, 7 days NAS, 90 days Azure Cold; checksum and complete metadata required"
  },
  "updatePolicy": {
    "imageUpdates": "renovate",
    "deployment": "portainer-gitops",
    "automatic": false
  },
  "requiredSecretNames": [
    "TS_AUTHKEY",
    "PALWORLD_ADMIN_PASSWORD"
  ]
}
