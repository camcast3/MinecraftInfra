#!/usr/bin/env bash
set -Eeuo pipefail
IFS=$'\n\t'

container=${1:?container name is required}
stop_timeout=${2:?stop timeout is required}

[[ "$container" == palworld-server ]] || {
  echo "Unexpected Palworld container: $container" >&2
  exit 78
}
[[ "$stop_timeout" =~ ^[1-9][0-9]*$ ]] || {
  echo "Stop timeout must be a positive integer" >&2
  exit 78
}

health=$(docker inspect -f \
  '{{if .State.Health}}{{.State.Health.Status}}{{else}}none{{end}}' \
  "$container")
[[ "$health" == healthy ]] || {
  echo "Palworld must be healthy before its REST backup hook runs" >&2
  exit 69
}

palworld_rest() {
  docker exec "$container" rest-cli "$@" --no-flush-log >/dev/null
}

shutdown_wait=60
if ((stop_timeout <= shutdown_wait + 15)); then
  shutdown_wait=$((stop_timeout > 15 ? stop_timeout - 15 : 1))
fi

palworld_rest announce \
  "{\"message\":\"Scheduled backup begins in ${shutdown_wait} seconds\"}"
palworld_rest save
palworld_rest shutdown \
  "{\"waittime\":${shutdown_wait},\"message\":\"Scheduled backup in progress\"}"
