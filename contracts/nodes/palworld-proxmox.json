{
  "$schema": "../node-contract.schema.json",
  "contractVersion": 1,
  "nodeId": "palworld-proxmox",
  "displayName": "Palworld Proxmox node",
  "lifecycle": "planned",
  "platform": "proxmox-vm",
  "provisioningPath": "infra/proxmox/game-node/profiles/palworld.json",
  "dataRoot": "/data/palworld",
  "managementEndpoints": [
    {
      "name": "lan-ssh",
      "protocol": "ssh",
      "port": 7822,
      "exposure": "lan",
      "purpose": "admin"
    },
    {
      "name": "tailscale-ssh",
      "protocol": "ssh",
      "port": 22,
      "exposure": "tailnet",
      "purpose": "admin"
    },
    {
      "name": "portainer-edge-agent",
      "protocol": "https",
      "port": null,
      "exposure": "outbound-only",
      "purpose": "agent"
    }
  ]
}
