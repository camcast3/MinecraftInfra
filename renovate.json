{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "extends": [
        "config:base",
        ":dependencyDashboard",
        ":enableVulnerabilityAlertsWithLabel('security')",
        ":preserveSemverRanges",
        ":rebaseStalePrs",
        "group:recommended"
    ],
    "customManagers": [
        {
            "customType": "regex",
            "description": "Keep production game contract image references pinned and current",
            "managerFilePatterns": [
                "/^(?:platform\\/contracts|contracts)\\/games\\/.*\\.json$/"
            ],
            "matchStrings": [
                "\"reference\"\\s*:\\s*\"(?<depName>[^\\s:\"]+(?:\\/[^\\s:\"]+)*):(?<currentValue>[^@\"]+)@(?<currentDigest>sha256:[a-f0-9]{64})\""
            ],
            "datasourceTemplate": "docker"
        }
    ],
    "labels": [
        "renovate"
    ],
    "packageRules": [
        {
            "description": "Keep canonical and compatibility C2E2 Compose updates in one PR",
            "matchFileNames": [
                "games/minecraft/c2e2/**",
                "docker/proxmox/**"
            ],
            "groupName": "C2E2 stack compatibility paths"
        },
        {
            "description": "Keep canonical and compatibility Palworld Compose updates in one PR",
            "matchFileNames": [
                "games/palworld/**",
                "docker/palworld/**"
            ],
            "groupName": "Palworld stack compatibility paths",
            "automerge": false
        },
        {
            "description": "Keep canonical and compatibility Windrose Compose updates in one PR",
            "matchFileNames": [
                "games/windrose/**",
                "docker/windrose/**"
            ],
            "groupName": "Windrose stack compatibility paths",
            "automerge": false
        },
        {
            "description": "Keep canonical and compatibility Azure edge updates in one PR",
            "matchFileNames": [
                "platform/azure/edge/**",
                "docker/azure/**"
            ],
            "groupName": "Azure edge compatibility paths"
        },
        {
            "description": "Keep canonical and compatibility contract image updates in one PR",
            "matchFileNames": [
                "platform/contracts/games/**",
                "contracts/games/**"
            ],
            "groupName": "Game contract compatibility paths"
        },
        {
            "description": "Require a reviewed, application-consistent Palworld update",
            "matchPackageNames": [
                "ghcr.io/pocketpairjp/palserver"
            ],
            "groupName": "Palworld official server",
            "automerge": false
        },
        {
            "groupName": "devDependencies (non-major)",
            "matchDepTypes": [
                "devDependencies",
                "require-dev"
            ],
            "matchUpdateTypes": [
                "digest",
                "minor",
                "patch"
            ]
        },
        {
            "description": "Update MariaDB or MySQL on a patch level only, bumps to major and minor versions might break compatibilty with an application",
            "enabled": false,
            "managers": [
                "docker-compose",
                "dockerfile"
            ],
            "matchUpdateTypes": [
                "major",
                "minor"
            ],
            "packagePatterns": [
                "^([^/]+\\/)*(mariadb|mysql)(:.+)?$"
            ]
        },
        {
            "description": "Update PostgreSQL on a minor version or patch level only, bumps to major versions might break compatibilty with an application",
            "enabled": false,
            "managers": [
                "docker-compose",
                "dockerfile"
            ],
            "matchUpdateTypes": [
                "major"
            ],
            "packagePatterns": [
                "^([^/]+\\/)*postgres(:.+)?$"
            ]
        },
        {
            "description": "Update MariaDB or PostgreSQL to the most recent release if they are standalone and not part of an application stack",
            "enabled": true,
            "managers": [
                "docker-compose",
                "dockerfile"
            ],
            "matchFileNames": [
                "docker-compose/mariadb/**",
                "docker-compose/postgres/**"
            ],
            "matchUpdateTypes": [
                "major",
                "minor",
                "patch"
            ],
            "packagePatterns": [
                "^([^/]+\\/)*(mariadb|postgres)(:.+)?$"
            ]
        },
        {
            "description": "Over time Heimdall changed its versioning schema several times, ensure we only consider the current style",
            "managers": [
                "docker-compose",
                "dockerfile"
            ],
            "packagePatterns": [
                "^([^/]+\\/)*heimdall(:.+)?$"
            ],
            "versioning": "regex:^(?<major>\\d{1,2})\\.(?<minor>\\d+)(\\.(?<patch>\\d+))?$"
        },
        {
            "description": "Track stable releases of Nginx only",
            "managers": [
                "docker-compose",
                "dockerfile"
            ],
            "packagePatterns": [
                "^([^/]+\\/)*nginx(:.+)?$"
            ],
            "versioning": "regex:^(?<major>\\d+)\\.(?<minor>\\d*[02468])(\\.(?<patch>\\d+))?(?:-(?<compatibility>.*))?$"
        },
        {
            "description": "Ignore erroneous version tags of Semaphore",
            "managers": [
                "docker-compose",
                "dockerfile"
            ],
            "packagePatterns": [
                "^([^/]+\\/)*semaphore(:.+)?$"
            ],
            "allowedVersions": "!/^v?2\\.19\\.10$/"
        }
    ],
    "separateMinorPatch": true,
    "stopUpdatingLabel": "renovate/stop_updating"
}